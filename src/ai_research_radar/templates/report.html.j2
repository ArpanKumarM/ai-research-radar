<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>AI Research Radar — {{ date }}</title>
<style>
  :root { --bg:#fbfaf7; --fg:#1d1d1f; --muted:#6b6b70; --accent:#2f5bd3; --card:#fff; --line:#e6e3dc; --warn:#fff6e0; }
  @media (prefers-color-scheme: dark) {
    :root { --bg:#141416; --fg:#ececef; --muted:#9a9aa2; --accent:#8aa8ff; --card:#1c1c20; --line:#2c2c33; --warn:#2e2714; }
  }
  body { background:var(--bg); color:var(--fg); margin:0; padding:2rem 1rem;
         font:16px/1.65 -apple-system, BlinkMacSystemFont, "Segoe UI", Inter, sans-serif; }
  main { max-width:48rem; margin:0 auto; }
  h1 { font-size:1.9rem; line-height:1.2; margin:0 0 .5rem; }
  h2 { margin-top:2.5rem; padding-bottom:.3rem; border-bottom:1px solid var(--line); }
  h3 { margin-top:2.2rem; line-height:1.3; }
  a { color:var(--accent); }
  blockquote { margin:1rem 0; padding:.6rem 1rem; background:var(--card); border-left:3px solid var(--accent); border-radius:4px; }
  blockquote:has(strong:first-child) p { margin:.3rem 0; }
  em { color:var(--muted); }
  ul { padding-left:1.2rem; } li { margin:.35rem 0; }
  hr { border:0; border-top:1px solid var(--line); margin:2.5rem 0 1rem; }
  .warn blockquote, blockquote.warn { background:var(--warn); border-left-color:#d49a00; }
</style>
</head>
<body><main>
{{ body }}
</main></body>
</html>
